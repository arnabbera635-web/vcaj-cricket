rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function admin(){ return signedIn() && request.auth.token.email == 'vcajofficial@gmail.com'; }
    function member(){ return signedIn() && exists(/databases/$(database)/documents/memberAccounts/$(request.auth.uid)); }

    match /liveMatches/{id} { allow read: if true; allow create, update: if admin(); allow delete: if false; }
    match /liveMatches/{id}/events/{eventId} { allow read: if true; allow create, update: if admin(); allow delete: if false; }
    match /matches/{id} { allow read: if true; allow create, update: if admin(); allow delete: if false; }
    match /matches/{id}/events/{eventId} { allow read: if true; allow create, update: if admin(); allow delete: if false; }
    match /players/{id} { allow read: if true; allow create, update: if admin(); allow delete: if false; }
    match /teams/{id} { allow read: if true; allow create, update, delete: if admin(); }
    match /seasons/{id} { allow read: if true; allow create, update: if admin(); allow delete: if false; }
    match /tournaments/{id} { allow read: if true; allow create, update: if admin(); allow delete: if false; }

    // Public team registration: create only. A temporary random token permits
    // the same browser submission to attach receipt metadata; it cannot edit
    // team/payment fields. Admin has full management access.
    match /teamRegistrations/{id} {
      allow create: if
        request.resource.data.season == '2026'
        && request.resource.data.status == 'pending'
        && request.resource.data.uniqueId is string
        && request.resource.data.verificationCode is string
        && request.resource.data.teamName is string
        && request.resource.data.whatsapp is string
        && request.resource.data.location is string
        && request.resource.data.entryFee.total == 3501
        && request.resource.data.entryFee.paid is number
        && request.resource.data.entryFee.due is number
        && request.resource.data.entryFee.paid >= 500
        && request.resource.data.entryFee.paid <= 3501
        && request.resource.data.kasanmani.total == 1500
        && request.resource.data.kasanmani.paid is number
        && request.resource.data.kasanmani.due is number
        && request.resource.data.kasanmani.paid >= 0
        && request.resource.data.kasanmani.paid <= 1500
        && request.resource.data.totalPaid is number
        && request.resource.data.totalDue is number
        && request.resource.data.paymentHistory is list;

      allow read, update, delete: if admin();
    }
    match /receiptVerifications/{code} {
      allow read: if true;
      allow create: if request.resource.data.verificationCode == code
        && code.matches('RC-[A-F0-9]{32}')
        && request.resource.data.uniqueId is string
        && request.resource.data.teamName is string
        && request.resource.data.entryPaid is number
        && request.resource.data.entryPaid >= 500
        && request.resource.data.entryPaid <= 3501
        && request.resource.data.entryDue == 3501 - request.resource.data.entryPaid
        && request.resource.data.kasanPaid is number
        && request.resource.data.kasanPaid >= 0
        && request.resource.data.kasanPaid <= 1500
        && request.resource.data.kasanDue == 1500 - request.resource.data.kasanPaid
        && request.resource.data.totalPaid == request.resource.data.entryPaid + request.resource.data.kasanPaid
        && request.resource.data.totalDue == request.resource.data.entryDue + request.resource.data.kasanDue
        && request.resource.data.status == 'pending'
        && request.resource.data.season == '2026'
        && request.resource.data.receiptType == 'OFFICIAL_PAYMENT_RECEIPT';
      allow update, delete: if admin();
    }

    match /members/{id} {
      allow read: if admin() || (member() && get(/databases/$(database)/documents/memberAccounts/$(request.auth.uid)).data.memberId == id);
      allow create, update, delete: if admin();
    }

    match /memberDirectory/{id} {
      allow read: if member() || admin();
      allow create, update, delete: if admin();
    }

    match /tournamentAccounts/{id} {
      allow read: if admin() || member();
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /memberAccounts/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if admin();
      allow update: if admin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword','passwordChangedAt','updatedAt'])
          && request.resource.data.mustChangePassword == false);
    }
  }
}
